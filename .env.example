# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Image model and optional fallback model if the first call fails
GEMINI_MODEL=gemini-3.1-flash-image
# Model used when "High" quality is selected in the studio
GEMINI_PRO_MODEL=gemini-3-pro-image
GEMINI_FALLBACK_MODEL=

# Optional Basic Auth: leave APP_PASSWORD empty to keep the app public
APP_USERNAME=user
APP_PASSWORD=

# Max render requests per IP per minute, and max size per uploaded image (MB)
RATE_LIMIT_PER_MINUTE=10
MAX_IMAGE_MB=8

# Image limits (Cairo calendar day, and rolling 7 days); only successful images count
DAILY_IMAGE_LIMIT=300
WEEKLY_IMAGE_LIMIT=600

# History: total size cap (MB, oldest removed first) and max age (days, starred images exempt)
HISTORY_MAX_MB=2048
HISTORY_MAX_DAYS=30
DATA_DIR=data

# How many images are generated at the same time
GEMINI_CONCURRENCY=2

# Port the server listens on (3000 inside Docker)
PORT=3000

# Domain used by Traefik in docker-compose.yml
APP_DOMAIN=arurafit.aaaaaaaaa9000.cloud
